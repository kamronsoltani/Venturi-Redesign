FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      snappyHexMeshDict;
}

castellatedMesh true;
snap            true;
addLayers       true;

geometry
{
    fluid
    {
        type triSurfaceMesh;
        file "fluid.stl";
        regions
        {
            inlet        { name inlet; }
            outlet       { name outlet; }
            symmetry     { name symmetry; }
            wall_esig    { name wall_esig; }
            wall_elbow   { name wall_elbow; }
            wall_venturi { name wall_venturi; }
        }
    }
    fineZone
    {
        type box;
        min (-0.16988 -0.018000000000000002 -0.001);
        max (0.016 0.034103913043478255 0.025);
    }
}

castellatedMeshControls
{
    maxLocalCells 4000000;
    maxGlobalCells 8000000;
    minRefinementCells 10;
    maxLoadUnbalance 0.10;
    nCellsBetweenLevels 3;
    features ( { file "fluid.eMesh"; level 2; } );
    refinementSurfaces
    {
        fluid
        {
            level (1 1);
            regions
            {
                inlet        { level (1 1); patchInfo { type patch; } }
                outlet       { level (2 2); patchInfo { type patch; } }
                symmetry     { level (0 0); patchInfo { type symmetry; } }
                wall_esig    { level (1 1); patchInfo { type wall; } }
                wall_elbow   { level (2 2); patchInfo { type wall; } }
                wall_venturi { level (2 2); patchInfo { type wall; } }
            }
        }
    }
    resolveFeatureAngle 30;
    refinementRegions
    {
        fineZone { mode inside; level 2; }
    }
    insidePoint (0.0 0.1 0.005);
    allowFreeStandingZoneFaces true;
}

snapControls
{
    nSmoothPatch 5;
    tolerance 2.0;
    nSolveIter 100;
    nRelaxIter 8;
    nFeatureSnapIter 15;
    implicitFeatureSnap false;
    explicitFeatureSnap true;
    multiRegionFeatureSnap true;
}

addLayersControls
{
    relativeSizes true;
    layers
    {
        "wall_.*" { nSurfaceLayers 3; }
    }
    expansionRatio 1.2;
    finalLayerThickness 0.45;
    minThickness 0.1;
    nGrow 0;
    featureAngle 120;
    slipFeatureAngle 30;
    nRelaxIter 5;
    nSmoothSurfaceNormals 1;
    nSmoothNormals 3;
    nSmoothThickness 10;
    maxFaceThicknessRatio 0.5;
    maxThicknessToMedialRatio 0.3;
    minMedialAxisAngle 90;
    nBufferCellsNoExtrude 0;
    nLayerIter 50;
}

meshQualityControls
{
    maxNonOrtho 65;
    maxBoundarySkewness 4;
    maxInternalSkewness 4;
    maxConcave 80;
    minVol 1e-16;
    minTetQuality 1e-15;
    minArea -1;
    minTwist 0.02;
    minDeterminant 0.001;
    minFaceWeight 0.05;
    minVolRatio 0.01;
    minTriangleTwist -1;
    nSmoothScale 4;
    errorReduction 0.75;
    relaxed { maxNonOrtho 70; maxInternalSkewness 4; maxBoundarySkewness 4; }
}

mergeTolerance 1e-6;
